// Cloudflare Workers の設定（セットアップ手順は docs/cloudflare-setup.md）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maternity-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // 画面（静的ファイル）。該当するファイルがないパス（/api/...）は Worker が処理する
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maternity-app",
      // `npx wrangler d1 create maternity-app` で表示される ID（GitHub Actions ではシークレット D1_DATABASE_ID で置き換える）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "maternity-app-media"
    }
  ],
  "observability": { "enabled": true }
}
